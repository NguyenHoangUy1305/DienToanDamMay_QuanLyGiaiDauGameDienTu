<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title>Nhập kết quả - FC Online</title>
    <style>
        .score-card { border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .vs-circle {
            width: 50px; height: 50px;
            background: #f8f9fa;
            border: 2px solid #dee2e6;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; margin: 0 auto;
            z-index: 10; position: relative;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'trandau' }) %>

    <div class="container mt-4" style="max-width: 1000px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Duyệt / Nhập kết quả trận đấu</h2>
            <span class="badge bg-primary fs-6"><%= trandau.GiaiDau ? trandau.GiaiDau.TenGiaiDau : 'Giải đấu' %></span>
        </div>

        <div class="mb-3"><%- message %></div>

        <% if (isLocked) { %>
            <div class="alert alert-secondary">Kết quả trận này đã chốt. Hệ thống khóa chỉnh sửa để đảm bảo công bằng.</div>
        <% } %>

        <form method="post" action="/trandau/nhap-ket-qua/<%= trandau._id %>">
            <div class="row align-items-center mb-4">
                <div class="col-md-5">
                    <div class="card score-card text-center p-3 border-primary border-3">
                        <h4 class="text-primary text-truncate"><%= trandau.DoiThu1 %></h4>

                        <% if (!isTeamMatch) { %>
                            <input type="number" class="form-control form-control-lg text-center fw-bold" name="TySo1" value="<%= trandau.TySo1 %>" min="0" <%= isLocked ? 'readonly' : '' %>>
                        <% } else { %>
                            <div class="text-start mt-3">
                                <label class="small text-muted mb-2">Bàn thắng từng cầu thủ:</label>
                                <% (doiHinhDoi1 || []).forEach(function(p) { %>
                                    <div class="input-group mb-2">
                                        <span class="input-group-text small" style="width: 120px;"><%= p.HoVaTen %></span>
                                        <input type="number" class="form-control" name="BanThangDoi1[<%= p._id %>]" value="<%= (banThangDoi1Map && banThangDoi1Map[p._id.toString()] != null) ? banThangDoi1Map[p._id.toString()] : 0 %>" min="0" <%= isLocked ? 'readonly' : '' %>>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="col-md-2 text-center">
                    <div class="vs-circle">VS</div>
                </div>

                <div class="col-md-5">
                    <div class="card score-card text-center p-3 border-danger border-3">
                        <h4 class="text-danger text-truncate"><%= trandau.DoiThu2 %></h4>

                        <% if (!isTeamMatch) { %>
                            <input type="number" class="form-control form-control-lg text-center fw-bold" name="TySo2" value="<%= trandau.TySo2 %>" min="0" <%= isLocked ? 'readonly' : '' %>>
                        <% } else { %>
                            <div class="text-start mt-3">
                                <label class="small text-muted mb-2">Bàn thắng từng cầu thủ:</label>
                                <% (doiHinhDoi2 || []).forEach(function(p) { %>
                                    <div class="input-group mb-2">
                                        <span class="input-group-text small" style="width: 120px;"><%= p.HoVaTen %></span>
                                        <input type="number" class="form-control" name="BanThangDoi2[<%= p._id %>]" value="<%= (banThangDoi2Map && banThangDoi2Map[p._id.toString()] != null) ? banThangDoi2Map[p._id.toString()] : 0 %>" min="0" <%= isLocked ? 'readonly' : '' %>>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (trandau.LinkMinhChung) { %>
                <div class="row">
                    <div class="col-md-<%= trandau.LinkMinhChungKhieuNai ? '6' : '12' %>">
                        <div class="card p-3 mb-4 shadow-sm border-info">
                            <div class="mb-2">
                                <label class="form-label fw-bold text-info-emphasis">
                                    <i class="bi bi-link-45deg"></i> Link Minh Chứng Gốc:
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" value="<%= trandau.LinkMinhChung %>" readonly>
                                    <a href="<%= trandau.LinkMinhChung %>" target="_blank" class="btn btn-info text-white">Mở xem</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% if (trandau.LinkMinhChungKhieuNai) { %>
                    <div class="col-md-6">
                        <div class="card p-3 mb-4 shadow-sm border-danger">
                            <div class="mb-2">
                                <label class="form-label fw-bold text-danger">
                                    <i class="bi bi-shield-exclamation"></i> Minh Chứng KHIẾU NẠI:
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" value="<%= trandau.LinkMinhChungKhieuNai %>" readonly>
                                    <a href="<%= trandau.LinkMinhChungKhieuNai %>" target="_blank" class="btn btn-danger text-white">Mở xem K.Nại</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
                </div>
            <% } %>

            <div class="card p-3 mb-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Vòng đấu:</label>
                        <span class="text-muted"><%= trandau.VongDau %></span>
                    </div>
                    <div class="col-md-7 text-end">
                        <% if (!isLocked) { %>
                            <% if (trandau.LinkMinhChung) { %>
                                <button type="submit" name="TuChoi" value="true" class="btn btn-danger btn-lg shadow text-nowrap" onclick="return confirm('Từ chối minh chứng này? Nó sẽ bị xóa!');">
                                    <i class="bi bi-x-circle me-1"></i>Từ chối
                                </button>
                            <% } %>
                            <button type="submit" class="btn btn-success btn-lg shadow text-nowrap ms-1">
                                <i class="bi bi-check-circle-fill me-1"></i>Duyệt & Cập nhật BXH
                            </button>
                        <% } else { %>
                            <button type="button" class="btn btn-secondary btn-lg shadow" disabled>Đã chốt kết quả</button>
                        <% } %>
                        <a href="/trandau" class="btn btn-outline-secondary btn-lg ms-1">Hủy</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>
