<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'trandau' }) %>
    <div class="container mt-4" style="max-width: 900px;">
        <h2 class="mb-3">Nhập kết quả trận đấu</h2>
        <div class="mb-3"><%- message %></div>

        <div class="card mb-3">
            <div class="card-body">
                <div><strong>Giải đấu:</strong> <%= trandau.GiaiDau ? trandau.GiaiDau.TenGiaiDau : '' %></div>
                <div><strong>Cặp đấu:</strong> <%= trandau.DoiThu1 %> vs <%= trandau.DoiThu2 %></div>
                <div><strong>Vòng đấu:</strong> <%= trandau.VongDau %></div>
                <div><strong>Thời gian:</strong> <%= new Date(trandau.ThoiGianThiDau).toLocaleString('vi-VN') %></div>
                <div><strong>Trạng thái hiện tại:</strong> <%= toVietnameseStatus(trandau.TrangThai) %></div>
            </div>
        </div>

        <form method="post" action="/trandau/nhap-ket-qua/<%= trandau._id %>">
            <% if (!isTeamMatch) { %>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="TySo1" class="form-label">Tỷ số <%= trandau.DoiThu1 %></label>
                        <input type="number" class="form-control" id="TySo1" name="TySo1" min="0" value="<%= trandau.TySo1 || 0 %>" required>
                    </div>
                    <div class="col-md-6">
                        <label for="TySo2" class="form-label">Tỷ số <%= trandau.DoiThu2 %></label>
                        <input type="number" class="form-control" id="TySo2" name="TySo2" min="0" value="<%= trandau.TySo2 || 0 %>" required>
                    </div>
                </div>
            <% } else { %>
                <% if (!doiHinhDoi1.length || !doiHinhDoi2.length) { %>
                    <div class="alert alert-warning">Không đủ danh sách người chơi của một trong hai đội để nhập kết quả theo từng người.</div>
                <% } else { %>
                    <div class="alert alert-info">Nhập số bàn từng người. Hệ thống sẽ tự cộng thành tỷ số đội.</div>
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-header fw-semibold"><%= trandau.DoiThu1 %></div>
                                <div class="card-body">
                                    <% doiHinhDoi1.forEach(function(item) { %>
                                        <div class="mb-2">
                                            <label class="form-label"><%= item.HoVaTen %></label>
                                            <input type="number" min="0" value="0" class="form-control" name="BanThangDoi1[<%= item._id %>]" />
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-header fw-semibold"><%= trandau.DoiThu2 %></div>
                                <div class="card-body">
                                    <% doiHinhDoi2.forEach(function(item) { %>
                                        <div class="mb-2">
                                            <label class="form-label"><%= item.HoVaTen %></label>
                                            <input type="number" min="0" value="0" class="form-control" name="BanThangDoi2[<%= item._id %>]" />
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Xác nhận kết quả</button>
                <a href="/trandau" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</body>
</html>
