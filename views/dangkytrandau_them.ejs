<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'trandau' }) %>
    <div class="container mt-4">
        <h2 class="mb-4">Thêm đăng ký giải đấu</h2>

        <form action="/dangkygiaidau/them" method="post">
            <div class="mb-3">
                <label for="GiaiDau" class="form-label">Giải đấu</label>
                <select class="form-select" id="GiaiDau" name="GiaiDau" required>
                    <option value="">-- Chọn giải đấu --</option>
                    <% giaidau.forEach(function(item) { %>
                        <option value="<%= item._id %>"><%= item.TenGiaiDau %></option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="NguoiChoi" class="form-label">Người chơi</label>
                <select class="form-select" id="NguoiChoi" name="NguoiChoi">
                    <option value="">-- Không chọn --</option>
                    <% nguoichoi.forEach(function(item) { %>
                        <option value="<%= item._id %>"><%= item.HoVaTen %></option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="DoiTuyen" class="form-label">Đội tuyển</label>
                <select class="form-select" id="DoiTuyen" name="DoiTuyen">
                    <option value="">-- Không chọn --</option>
                    <% doituyen.forEach(function(item) { %>
                        <option value="<%= item._id %>"><%= item.TenDoi %></option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="NgayDangKy" class="form-label">Ngày đăng ký</label>
                <input type="date" class="form-control" id="NgayDangKy" name="NgayDangKy" required />
            </div>

            <div class="mb-3">
                <label for="TrangThaiDuyet" class="form-label">Trạng thái duyệt</label>
                <select class="form-select" id="TrangThaiDuyet" name="TrangThaiDuyet">
                    <option value="Chờ duyệt">Chờ duyệt</option>
                    <option value="Đã duyệt">Đã duyệt</option>
                    <option value="Từ chối">Từ chối</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Lưu</button>
            <a href="/dangkygiaidau" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</body>
</html>