<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %></title>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'giaidau' }) %>
    <div class="container mt-4 pb-5">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">TẠO GIẢI ĐẤU MỚI</h4>
            </div>
            <div class="card-body">
                <form action="/giaidau/them" method="post" id="formThemGiai">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Tên giải đấu</label>
                            <input type="text" class="form-control" name="TenGiaiDau" placeholder="VD: Champions Cup 2026" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày bắt đầu</label>
                            <input type="date" class="form-control" id="NgayBatDau" name="NgayBatDau" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày kết thúc</label>
                            <input type="date" class="form-control" id="NgayKetThuc" name="NgayKetThuc" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thể thức</label>
                            <select class="form-select" name="TheThuc" required>
                                <option value="1vs1">Cá nhân 1vs1</option>
                                <option value="doi">Thi đấu Đội</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số lượng tối đa</label>
                            <input type="number" class="form-control" name="SoLuongToiDa" value="16" min="2" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Mô tả giải đấu</label>
                            <textarea class="form-control" name="MoTa" rows="3" placeholder="Thông tin về giải thưởng, quy định..."></textarea>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary px-4">Lưu giải đấu</button>
                        <a href="/giaidau" class="btn btn-outline-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script>
        // Logic Pro: Chặn ngày kết thúc trước ngày bắt đầu
        const batDau = document.getElementById('NgayBatDau');
        const ketThuc = document.getElementById('NgayKetThuc');
        batDau.addEventListener('change', () => { ketThuc.min = batDau.value; });
    </script>
</body>
</html>