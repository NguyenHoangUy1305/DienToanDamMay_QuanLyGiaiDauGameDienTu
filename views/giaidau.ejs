<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <% 
        if (typeof canManage === 'undefined') { var canManage = false; }
        if (typeof isAdmin === 'undefined') { var isAdmin = false; }
        if (typeof message === 'undefined') { var message = ''; }
    %>
    <div class="container mt-4">
        <%- include('partials/sidebar', { active: 'giaidau' }) %>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Quản lý giải đấu</h2>
            <% if (canManage) { %>
                <a href="/giaidau/them" class="btn btn-success"><i class="bi bi-plus-circle"></i> Thêm giải đấu</a>
            <% } %>
        </div>

        <div class="mb-3"><%- message %></div>

        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#giai1vs1" type="button">Giải 1vs1</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#giaidoi" type="button">Giải đội</button></li>
        </ul>

        <div class="tab-content border border-top-0 p-3 bg-white">
            <div class="tab-pane fade show active" id="giai1vs1">
                <%- include('partials/giaidau_table', { data: giaidau1vs1, emptyText: 'Chưa có giải 1vs1.', canManage: canManage, isAdmin: isAdmin, toVietnameseTournamentType: toVietnameseTournamentType, toVietnameseTournamentStatus: toVietnameseTournamentStatus }) %>
            </div>
            <div class="tab-pane fade" id="giaidoi">
                <%- include('partials/giaidau_table', { data: giaidauDoi, emptyText: 'Chưa có giải đội.', canManage: canManage, isAdmin: isAdmin, toVietnameseTournamentType: toVietnameseTournamentType, toVietnameseTournamentStatus: toVietnameseTournamentStatus }) %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
