<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'trandau' }) %>
    <div class="container mt-4">
        <h2 class="mb-4">Thêm trận đấu</h2>

        <form action="/trandau/them" method="post">
            <div class="mb-3">
                <label for="GiaiDau" class="form-label">Giải đấu</label>
                <select class="form-select" id="GiaiDau" name="GiaiDau" required>
                    <option value="">-- Chọn giải đấu --</option>
                    <% giaidau.forEach(function(item) { %>
                        <option value="<%= item._id %>"><%= item.TenGiaiDau %> (<%= item.TheThuc %>)</option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="LoaiDoiTuongThiDau" class="form-label">Kiểu đối tượng</label>
                <select class="form-select" id="LoaiDoiTuongThiDau" name="LoaiDoiTuongThiDau">
                    <option value="NguoiChoi">Cá nhân</option>
                    <option value="DoiTuyen">Đội tuyển</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="VongDau" class="form-label">Vòng đấu</label>
                <input type="text" class="form-control" id="VongDau" name="VongDau" required />
            </div>

            <div class="mb-3">
                <label for="DoiThu1Id" class="form-label">Đối thủ 1 (từ danh sách đã duyệt)</label>
                <select class="form-select" id="DoiThu1Id" name="DoiThu1Id" required>
                    <option value="">-- Chọn đối thủ 1 --</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="DoiThu2Id" class="form-label">Đối thủ 2 (từ danh sách đã duyệt)</label>
                <select class="form-select" id="DoiThu2Id" name="DoiThu2Id" required>
                    <option value="">-- Chọn đối thủ 2 --</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="ThoiGianThiDau" class="form-label">Thời gian thi đấu</label>
                <input type="datetime-local" class="form-control" id="ThoiGianThiDau" name="ThoiGianThiDau" required />
            </div>

            <div class="mb-3">
                <label for="TySo1" class="form-label">Tỷ số đối thủ 1 (nếu đã có kết quả)</label>
                <input type="number" class="form-control" id="TySo1" name="TySo1" value="0" min="0" />
            </div>

            <div class="mb-3">
                <label for="TySo2" class="form-label">Tỷ số đối thủ 2 (nếu đã có kết quả)</label>
                <input type="number" class="form-control" id="TySo2" name="TySo2" value="0" min="0" />
            </div>

            <div class="mb-3">
                <label for="TrangThai" class="form-label">Trạng thái</label>
                <select class="form-select" id="TrangThai" name="TrangThai">
                    <option value="Chua thi dau">Chưa thi đấu</option>
                    <option value="Dang thi dau">Đang thi đấu</option>
                    <option value="Da thi dau">Đã thi đấu</option>
                    <option value="Tam hoan">Tạm hoãn</option>
                    <option value="Huy">Hủy</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Lưu</button>
            <a href="/trandau" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>

    <script id="giaiDauMetaData" type="application/json"><%- JSON.stringify(giaiDauMeta || []) %></script>
    <script id="defaultLoaiData" type="application/json"><%- JSON.stringify(defaultLoaiDoiTuong || '') %></script>
    <script>
        const giaiDauMeta = JSON.parse(document.getElementById('giaiDauMetaData').textContent || '[]');
        const giaiDauSelect = document.getElementById('GiaiDau');
        const doiThu1Select = document.getElementById('DoiThu1Id');
        const doiThu2Select = document.getElementById('DoiThu2Id');
        const selectLoai = document.getElementById('LoaiDoiTuongThiDau');
        const initialLoai = JSON.parse(document.getElementById('defaultLoaiData').textContent || '""');

        function renderOptions(selectedTournamentId, type) {
            const tournament = giaiDauMeta.find(x => x.id === selectedTournamentId);
            const participants = tournament ? tournament.participants : [];
            const filtered = type ? participants.filter(p => p.type === type) : participants;

            const html = ['<option value="">-- Chọn --</option>']
                .concat(filtered.map(p => `<option value="${p.id}">${p.name}</option>`))
                .join('');

            doiThu1Select.innerHTML = html;
            doiThu2Select.innerHTML = html;
        }

        giaiDauSelect.addEventListener('change', function() {
            const tournament = giaiDauMeta.find(x => x.id === this.value);
            const defaultType = initialLoai || (tournament && tournament.isTeam ? 'DoiTuyen' : 'NguoiChoi');
            selectLoai.value = defaultType;
            renderOptions(this.value, selectLoai.value);
        });

        selectLoai.addEventListener('change', function() {
            renderOptions(giaiDauSelect.value, this.value);
        });

        // initialize if already selected
        (function init() {
            if (giaiDauSelect.value) {
                const tournament = giaiDauMeta.find(x => x.id === giaiDauSelect.value);
                const defaultType = initialLoai || (tournament && tournament.isTeam ? 'DoiTuyen' : 'NguoiChoi');
                selectLoai.value = defaultType;
                renderOptions(giaiDauSelect.value, selectLoai.value);
            }
        })();
    </script>
</body>
</html>