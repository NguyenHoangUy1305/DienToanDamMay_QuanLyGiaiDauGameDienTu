<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %></title>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'giaidau' }) %>
    <div class="container mt-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0 fw-bold">CHỈNH SỬA GIẢI ĐẤU</h4>
            </div>
            <div class="card-body bg-white">
                <form action="/giaidau/sua/<%= giaidau._id %>" method="post">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Tên giải đấu</label>
                            <input type="text" class="form-control" name="TenGiaiDau" value="<%= giaidau.TenGiaiDau %>" required />
                        </div>
                        
                        <% 
                            // Hàm định dạng ngày chuẩn cho Input Date
                            function formatDate(d) {
                                if(!d) return '';
                                let date = new Date(d);
                                return date.toISOString().split('T')[0];
                            }
                        %>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày bắt đầu</label>
                            <input type="date" class="form-control" name="NgayBatDau" value="<%= formatDate(giaidau.NgayBatDau) %>" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày kết thúc</label>
                            <input type="date" class="form-control" name="NgayKetThuc" value="<%= formatDate(giaidau.NgayKetThuc) %>" required />
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Thể thức</label>
                            <select class="form-select" name="TheThuc" required>
                                <option value="1vs1" <%= giaidau.TheThuc === '1vs1' ? 'selected' : '' %>>1vs1</option>
                                <option value="doi" <%= ['doi','Đội','team'].includes(giaidau.TheThuc) ? 'selected' : '' %>>Đội</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Số lượng</label>
                            <input type="number" class="form-control" name="SoLuongToiDa" value="<%= giaidau.SoLuongToiDa %>" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <select class="form-select" name="TrangThai">
                                <option value="Sap dien ra" <%= giaidau.TrangThai === 'Sap dien ra' ? 'selected' : '' %>>Sắp diễn ra</option>
                                <option value="Dang dien ra" <%= giaidau.TrangThai === 'Dang dien ra' ? 'selected' : '' %>>Đang diễn ra</option>
                                <option value="Da ket thuc" <%= giaidau.TrangThai === 'Da ket thuc' ? 'selected' : '' %>>Đã kết thúc</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Mô tả</label>
                            <textarea class="form-control" name="MoTa" rows="3"><%= giaidau.MoTa %></textarea>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-warning fw-bold">Cập nhật thay đổi</button>
                        <a href="/giaidau" class="btn btn-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>