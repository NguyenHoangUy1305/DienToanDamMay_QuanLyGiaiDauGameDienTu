<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng ký thành viên - FC Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
            background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
        }
        .auth-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .auth-card {
            width: 100%;
            max-width: 550px;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            background: #fff;
        }
        .auth-head {
            background: #2563eb;
            color: #fff;
            padding: 25px;
            text-align: center;
        }
        .auth-body {
            padding: 30px;
        }
        .form-label { font-weight: 600; color: #475569; }
        .btn-success { background-color: #2563eb; border: none; padding: 10px 20px; font-weight: 700; }
        .btn-success:hover { background-color: #1d4ed8; }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-card shadow-lg">
            <div class="auth-head">
                <h3 class="mb-1 fw-bold"><i class="bi bi-controller me-2"></i>GIA NHẬP FC ONLINE</h3>
                <div class="small text-white-75">Tạo tài khoản để đăng ký tham gia các giải đấu</div>
            </div>
            <div class="auth-body">
                <div class="mb-3"><%- typeof message !== 'undefined' ? message : '' %></div>
                <form action="/dangky" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="HoVaTen" class="form-label">Họ và tên thật</label>
                            <input type="text" class="form-control" id="HoVaTen" name="HoVaTen" placeholder="Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" placeholder="vidu@gmail.com" required />
                        </div>
                        <div class="col-md-6">
                            <label for="TenDangNhap" class="form-label">Tên đăng nhập (Tài khoản)</label>
                            <input type="text" class="form-control" id="TenDangNhap" name="TenDangNhap" required />
                        </div>
                        <div class="col-md-6">
                            <label for="MatKhau" class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control" id="MatKhau" name="MatKhau" required />
                        </div>
                    </div>
                    
                    <div class="mt-4">
                        <div class="form-check small mb-3">
                            <input class="form-check-input" type="checkbox" id="terms" required>
                            <label class="form-check-label text-muted" for="terms">
                                Tôi đồng ý với điều khoản tham gia giải đấu FC Online.
                            </label>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">ĐĂNG KÝ NGAY</button>
                            <a href="/dangnhap" class="btn btn-link text-decoration-none small">Đã có tài khoản? Đăng nhập</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>