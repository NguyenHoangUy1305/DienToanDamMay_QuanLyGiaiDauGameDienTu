<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <title><%= typeof title !== 'undefined' ? title : 'Đội tuyển' %> - FC Online</title>
</head>
<body class="bg-light">
    <%
        if (typeof canManage === 'undefined') { var canManage = false; }
        if (typeof isAdmin === 'undefined') { var isAdmin = false; }
        if (typeof pendingTeamId === 'undefined') { var pendingTeamId = ''; }
        var globalPendingTeamId = '';
        if (!canManage && typeof currentPlayer !== 'undefined' && currentPlayer && Array.isArray(doituyen)) {
            for (var i = 0; i < doituyen.length; i++) {
                var t = doituyen[i];
                var cho = t && t.ThanhVienChoDuyet ? t.ThanhVienChoDuyet : [];
                var coCho = cho.some(function (m) {
                    return m && m._id && m._id.toString() === currentPlayer._id.toString();
                });
                if (coCho) { globalPendingTeamId = t._id.toString(); break; }
            }
        }
    %>

    <%- include('partials/sidebar', { active: 'doituyen' }) %>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold"><i class="bi bi-shield-shaded text-primary me-2"></i>Quản lý Đội tuyển</h2>
            <% if (canManage) { %>
                <a href="/doituyen/them" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i>Thêm Đội tuyển mới</a>
            <% } %>
        </div>

        <% if (typeof session !== 'undefined' && session.success) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i><%= session.success %>
                <button class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% delete session.success; %>
        <% } %>

        <% if (typeof session !== 'undefined' && session.error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><%= session.error %>
                <button class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% delete session.error; %>
        <% } %>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Tên đội</th>
                            <th>Đội trưởng</th>
                            <th class="text-center">Thành viên (Max 4)</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-3" width="280">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof doituyen !== 'undefined' && doituyen.length > 0) { %>
                            <% doituyen.forEach(function(item) {
                                let soLuong = item.ThanhVien ? item.ThanhVien.length : 0;
                                let isFull = soLuong >= 4;
                            %>
                                <tr>
                                    <td class="ps-3 fw-bold text-primary"><%= item.TenDoi %></td>
                                    <td>
                                        <div class="fw-semibold"><%= item.TruongDoi || 'Chưa có' %></div>
                                        <% if (canManage) { %><small class="text-muted"><%= item.SoDienThoai || '' %></small><% } %>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge <%= isFull ? 'bg-danger' : 'bg-info text-dark' %> fs-6 px-3"><%= soLuong %> / 4</span>
                                        <% if (item.ThanhVien && item.ThanhVien.length > 0) { %>
                                            <div class="small text-muted mt-1 fw-medium"><%= item.ThanhVien.map(function(tv){ return tv.HoVaTen; }).join(' • ') %></div>
                                        <% } %>
                                    </td>

                                    <td class="text-center">
                                        <% if (item.KichHoat) { %>
                                            <span class="badge bg-success-subtle text-success border border-success">Hoạt động</span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Đã khóa</span>
                                        <% } %>
                                    </td>

                                    <td class="text-end pe-3">
                                        <% if (canManage) { %>
                                            <div class="mb-2">
                                                <a href="/doituyen/sua/<%= item._id %>" class="btn btn-warning btn-sm shadow-sm" title="Sửa"><i class="bi bi-pencil"></i></a>
                                                <% if (isAdmin) { %>
                                                    <form action="/doituyen/xoa/<%= item._id %>" method="post" style="display:inline" onsubmit="return confirm('Xác nhận xóa đội này?');">
                                                        <button class="btn btn-danger btn-sm shadow-sm" title="Xóa"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                <% } %>
                                            </div>

                                            <% if (item.ThanhVienChoDuyet && item.ThanhVienChoDuyet.length > 0) { %>
                                                <div class="bg-warning-subtle p-2 rounded text-start mt-2 border border-warning">
                                                    <div class="small fw-bold text-dark mb-1"><i class="bi bi-hourglass-split text-warning"></i> Chờ duyệt:</div>
                                                    <% item.ThanhVienChoDuyet.forEach(function(nguoiCho){ %>
                                                        <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-1 mb-1">
                                                            <small class="text-truncate fw-medium" style="max-width: 120px;" title="<%= nguoiCho.HoVaTen %>"><%= nguoiCho.HoVaTen %></small>
                                                            <div class="btn-group">
                                                                <form action="/doituyen/duyet-thanh-vien/<%= item._id %>/<%= nguoiCho._id %>" method="POST">
                                                                    <button type="submit" class="btn btn-success btn-sm py-0 px-1 shadow-sm" title="Duyệt"><i class="bi bi-check-lg"></i></button>
                                                                </form>
                                                                <form action="/doituyen/tu-choi-thanh-vien/<%= item._id %>/<%= nguoiCho._id %>" method="POST">
                                                                    <button type="submit" class="btn btn-danger btn-sm py-0 px-1 shadow-sm" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                            <% } %>

                                        <% } else if (typeof currentPlayer !== 'undefined' && currentPlayer) { %>
                                            <%
                                                let isMember = (item.ThanhVien || []).some(function(m){ return m._id.toString() === currentPlayer._id.toString(); });
                                                let isPending = (item.ThanhVienChoDuyet || []).some(function(m){ return m._id.toString() === currentPlayer._id.toString(); });
                                                let hasOtherTeam = (currentPlayer.DoiTuyen != null) && (currentPlayer.DoiTuyen.toString() !== item._id.toString());
                                                let hasPendingThisTeam = isPending || (!!globalPendingTeamId && globalPendingTeamId === item._id.toString());
                                                let hasPendingOtherTeam = !hasPendingThisTeam && !!globalPendingTeamId && globalPendingTeamId !== item._id.toString();
                                            %>


                                            <% if (isMember) { %>
                                                <button class="btn btn-success btn-sm shadow-sm" disabled><i class="bi bi-house-door-fill me-1"></i>Đội của bạn</button>
                                            <% } else if (hasOtherTeam) { %>
                                                <button class="btn btn-outline-secondary btn-sm" disabled title="Bạn đã có đội khác. Rời đội cũ trước nhé!">Khóa</button>
                                            <% } else if (hasPendingThisTeam) { %>
                                                <button class="btn btn-secondary btn-sm shadow-sm" disabled><i class="bi bi-hourglass-split me-1"></i>Đang chờ Sếp duyệt</button>
                                            <% } else if (hasPendingOtherTeam) { %>
                                                <button class="btn btn-outline-secondary btn-sm" disabled>Khóa</button>
                                            <% } else if (isFull) { %>
                                                <button class="btn btn-danger btn-sm shadow-sm" disabled><i class="bi bi-x-circle-fill me-1"></i>Đã Full Người</button>
                                            <% } else { %>
                                                <form action="/doituyen/xin-gia-nhap/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-primary btn-sm shadow-sm"><i class="bi bi-box-arrow-in-right me-1"></i>Xin gia nhập</button>
                                                </form>
                                            <% } %>

                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center py-5 text-muted">Chưa có Đội tuyển nào tham chiến.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

