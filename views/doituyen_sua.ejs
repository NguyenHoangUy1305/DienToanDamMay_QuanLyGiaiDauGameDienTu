<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'doituyen' }) %>
    <div class="container mt-4">
        <h2 class="mb-4">Sửa đội tuyển</h2>

        <form action="/doituyen/sua/<%= doituyen._id %>" method="post">
            <div class="mb-3">
                <label for="TenDoi" class="form-label">Tên đội</label>
                <input type="text" class="form-control" id="TenDoi" name="TenDoi" value="<%= doituyen.TenDoi %>" required />
            </div>

            <div class="mb-3">
                <label for="TruongDoi" class="form-label">Trưởng đội</label>
                <input type="text" class="form-control" id="TruongDoi" name="TruongDoi" value="<%= doituyen.TruongDoi %>" />
            </div>

            <div class="mb-3">
                <label for="SoDienThoai" class="form-label">Số điện thoại</label>
                <input type="text" class="form-control" id="SoDienThoai" name="SoDienThoai" value="<%= doituyen.SoDienThoai %>" />
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label">Email</label>
                <input type="email" class="form-control" id="Email" name="Email" value="<%= doituyen.Email %>" />
            </div>

            <div class="mb-3">
                <label for="GhiChu" class="form-label">Ghi chú</label>
                <textarea class="form-control" id="GhiChu" name="GhiChu" rows="3"><%= doituyen.GhiChu %></textarea>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="KichHoat" name="KichHoat" <%= doituyen.KichHoat ? 'checked' : '' %> />
                <label class="form-check-label" for="KichHoat">Kích hoạt</label>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a href="/doituyen" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</body>
</html>