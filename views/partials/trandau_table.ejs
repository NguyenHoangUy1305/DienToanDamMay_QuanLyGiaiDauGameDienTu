<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Giải đấu</th>
            <th>Vòng đấu</th>
            <th>Đối thủ 1</th>
            <th>Đối thủ 2</th>
            <th>Thời gian</th>
            <th>Tỷ số</th>
            <th>Người thắng</th>
            <th>Trạng thái</th>
            <th width="480">Chức năng</th>
        </tr>
    </thead>
    <tbody>
        <% if (data && data.length > 0) { %>
            <% data.forEach(function(item) { %>
                <% 
                    var isResultLocked = !!item.KetQuaXacNhan || (item.TrangThai === 'FINISHED' || item.TrangThai === 'DA_THI_DAU');
                    var laTranDoi = item && (item.LoaiTran === 'TEAM' || item.LoaiDoiTuongThiDau === 'DoiTuyen');

                    var tySoChinh = (item.TySo1 + ' - ' + item.TySo2);
                    var tySoPhu = '';

                    var diemGame1 = 0; var diemGame2 = 0;
                    if (laTranDoi && item.ChiTietTySo && item.DanhSachKeoDau) {
                        var mapBanThangT = {};
                        (item.ChiTietTySo || []).forEach(function(ct){
                            if(ct && ct.NguoiChoi) mapBanThangT[ct.NguoiChoi.toString()] = Number(ct.BanThang || 0);
                        });
                        (item.DanhSachKeoDau || []).forEach(function(k){
                            var p1 = k.NguoiChoi1Id ? k.NguoiChoi1Id.toString() : '';
                            var p2 = k.NguoiChoi2Id ? k.NguoiChoi2Id.toString() : '';
                            if(p1 && p2) {
                                var s1 = mapBanThangT[p1] || 0;
                                var s2 = mapBanThangT[p2] || 0;
                                if(s1 > s2) diemGame1++;
                                else if(s2 > s1) diemGame2++;
                            }
                        });
                        
                        // Nếu đã có chi tiết tỷ số thì hiển thị tỷ số thắng game, và phụ là tổng bàn thắng
                        if (item.ChiTietTySo.length > 0) {
                            tySoChinh = diemGame1 + ' - ' + diemGame2;
                            tySoPhu = 'Tổng bàn thắng: ' + item.TySo1 + ' - ' + item.TySo2;
                        }
                    }

                    if (isNguoiChoiLogin && currentNguoiChoiId && laTranDoi) {
                        var idMe = currentNguoiChoiId.toString();
                        var keo = (item.DanhSachKeoDau || []).find(function(k){
                            var p1 = (k && k.NguoiChoi1Id) ? k.NguoiChoi1Id.toString() : '';
                            var p2 = (k && k.NguoiChoi2Id) ? k.NguoiChoi2Id.toString() : '';
                            return p1 === idMe || p2 === idMe;
                        });

                        if (keo) {
                            var meLaBen1 = keo.NguoiChoi1Id && keo.NguoiChoi1Id.toString() === idMe;
                            var idDoiThu = meLaBen1 ? (keo.NguoiChoi2Id ? keo.NguoiChoi2Id.toString() : '') : (keo.NguoiChoi1Id ? keo.NguoiChoi1Id.toString() : '');
                            var tenDoiThu = meLaBen1 ? (keo.TenNguoiChoi2 || 'Đối thủ') : (keo.TenNguoiChoi1 || 'Đối thủ');

                            var ctMe = (item.ChiTietTySo || []).find(function(ct){ return ct && ct.NguoiChoi && ct.NguoiChoi.toString() === idMe; });
                            var ctDoiThu = (item.ChiTietTySo || []).find(function(ct){ return ct && ct.NguoiChoi && ct.NguoiChoi.toString() === idDoiThu; });

                            var banMe = ctMe ? Number(ctMe.BanThang || 0) : 0;
                            var banDoiThu = ctDoiThu ? Number(ctDoiThu.BanThang || 0) : 0;

                            tySoChinh = banMe + ' - ' + banDoiThu + ' (vs ' + tenDoiThu + ')';
                            tySoPhu = (item.ChiTietTySo.length > 0) ? 'Tổng đội: ' + diemGame1 + ' - ' + diemGame2 + ' (' + item.TySo1 + '-' + item.TySo2 + ')' : 'Tổng đội: ' + item.TySo1 + ' - ' + item.TySo2;
                        }
                    }
                %>
                <tr>
                    <td><%= item.GiaiDau ? item.GiaiDau.TenGiaiDau : '' %></td>
                    <td><%= item.VongDau %></td>
                    <td>
                        <%= item.DoiThu1 %>
                        <% if(typeof mapLienHe !== 'undefined' && item.DoiThu1Id && mapLienHe[item.DoiThu1Id.toString()]) { %>
                            <div class="small text-secondary mt-1" style="font-size: 0.75rem;"><i class="bi bi-info-circle-fill me-1"></i><%= mapLienHe[item.DoiThu1Id.toString()] %></div>
                        <% } %>
                    </td>
                    <td>
                        <%= item.DoiThu2 %>
                        <% if(typeof mapLienHe !== 'undefined' && item.DoiThu2Id && mapLienHe[item.DoiThu2Id.toString()]) { %>
                            <div class="small text-secondary mt-1" style="font-size: 0.75rem;"><i class="bi bi-info-circle-fill me-1"></i><%= mapLienHe[item.DoiThu2Id.toString()] %></div>
                        <% } %>
                    </td>
                    <td><%= item.ThoiGianThiDau ? new Date(item.ThoiGianThiDau).toLocaleString('vi-VN') : '' %></td>
                    <td>
                        <div><%= tySoChinh %></div>
                        <% if (tySoPhu) { %><small class="text-muted"><%= tySoPhu %></small><% } %>
                    </td>
                    <td><%= item.NguoiThang || '' %></td>
                    <td>
                        <% 
                            var trangThaiHienThi = (typeof toVietnameseStatus === 'function') ? toVietnameseStatus(item.TrangThai) : (item.TrangThai || '');
                            if (isResultLocked && trangThaiHienThi !== 'Đã thi đấu') {
                                trangThaiHienThi = 'Đã thi đấu';
                            }
                        %>
                        <%= trangThaiHienThi %>
                    </td>
                    <td>
                        <a href="/trandau/chi-tiet/<%= item._id %>" class="btn btn-outline-dark btn-sm mb-1">Xem chi tiết</a>
                        <% if (canManage) { %>
                            <% if (isResultLocked) { %>
                                <button type="button" class="btn btn-secondary btn-sm mb-1" disabled>Sửa</button>
                                <button type="button" class="btn btn-secondary btn-sm mb-1" disabled>Đã chốt kết quả</button>
                            <% } else { %>
                                <a href="/trandau/sua/<%= item._id %>" class="btn btn-warning btn-sm mb-1">Sửa</a>
                                <% if (item.TrangThai === 'PENDING_APPROVAL') { %>
                                    <a href="/trandau/nhap-ket-qua/<%= item._id %>" class="btn btn-success btn-sm mb-1 fw-bold">Duyệt kết quả</a>
                                <% } else if (item.TrangThai === 'DISPUTE') { %>
                                    <a href="/trandau/nhap-ket-qua/<%= item._id %>" class="btn btn-danger btn-sm mb-1 fw-bold text-white">Xử lý Khiếu nại</a>
                                <% } else { %>
                                    <a href="/trandau/nhap-ket-qua/<%= item._id %>" class="btn btn-primary btn-sm mb-1">Nhập kết quả</a>
                                <% } %>
                            <% } %>
                            <% if (isAdmin) { %>
                                <a href="/trandau/xoa/<%= item._id %>" class="btn btn-danger btn-sm mb-1" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                            <% } %>
                            <a href="/trandau/xuat-lich/<%= item._id %>" target="_blank" rel="noopener noreferrer" class="btn btn-info btn-sm text-white mb-1">Xuất lịch</a>
                            <a href="/trandau/mo-lich/<%= item._id %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline-info btn-sm mb-1">Mở lịch</a>
                        <% } else if (isNguoiChoiLogin) { %>
                            <% if (isResultLocked) { %>
                                <button type="button" class="btn btn-secondary btn-sm mb-1" disabled>Đã chốt KQ</button>
                            <% } else if (item.TrangThai === 'DISPUTE') { %>
                                <button type="button" class="btn btn-danger btn-sm mb-1 fw-bold" disabled>Đang tranh chấp</button>
                            <% } else if (item.TrangThai === 'PENDING_APPROVAL') { %>
                                <% if (item.NguoiKhaiBao && session && item.NguoiKhaiBao.toString() === session.MaNguoiDung.toString()) { %>
                                    <button type="button" class="btn btn-warning btn-sm mb-1 text-dark fw-bold" disabled>Đang chờ duyệt</button>
                                <% } else { %>
                                    <a href="/trandau/khieu-nai/<%= item._id %>" class="btn btn-danger btn-sm mb-1 fw-bold">Kiểm tra & Khiếu nại</a>
                                <% } %>
                            <% } else { %>
                                <a href="/trandau/khai-bao/<%= item._id %>" class="btn btn-warning btn-sm mb-1 fw-bold text-dark">Báo cáo KQ</a>
                            <% } %>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr><td colspan="9" class="text-center"><%= emptyText %></td></tr>
        <% } %>
    </tbody>
</table>
