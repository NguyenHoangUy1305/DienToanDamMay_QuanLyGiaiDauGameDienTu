<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Họ và tên</th>
            <th>Nickname</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Rank</th>
            <th>Đội tuyển</th>
            <th>Kích hoạt</th>
            <th width="170">Chức năng</th>
        </tr>
    </thead>
    <tbody>
        <% if (data && data.length > 0) { %>
            <% data.forEach(function(item) { %>
                <tr>
                    <td><%= item.HoVaTen %></td>
                    <td><%= item.NickName %></td>
                    <td><%= item.Email || '' %></td>
                    <td><%= item.SoDienThoai || '' %></td>
                    <td><%= item.Rank || '' %></td>
                    <td><%= item.DoiTuyen ? item.DoiTuyen.TenDoi : 'Cá nhân' %></td>
                    <td><%= item.KichHoat ? 'Có' : 'Không' %></td>
                    <td>
                        <% if (canManage) { %>
                            <a href="/nguoichoi/sua/<%= item._id %>" class="btn btn-warning btn-sm">Sửa</a>
                            <% if (isAdmin) { %>
                                <a href="/nguoichoi/xoa/<%= item._id %>" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                            <% } %>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr><td colspan="8" class="text-center"><%= emptyText %></td></tr>
        <% } %>
    </tbody>
</table>
