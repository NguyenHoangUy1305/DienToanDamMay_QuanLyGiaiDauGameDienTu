<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'bangxephang' }) %>
    <div class="container mt-4">
        <h2 class="mb-4">Sửa bảng xếp hạng</h2>

        <form action="/bangxephang/sua/<%= bangxephang._id %>" method="post">
            <div class="mb-3">
                <label for="GiaiDau" class="form-label">Giải đấu</label>
                <select class="form-select" id="GiaiDau" name="GiaiDau" required>
                    <% giaidau.forEach(function(item) { %>
                        <option value="<%= item._id %>" <%= bangxephang.GiaiDau && bangxephang.GiaiDau.toString() == item._id.toString() ? 'selected' : '' %>>
                            <%= item.TenGiaiDau %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="DoiTuongThiDau" class="form-label">Đối tượng thi đấu</label>
                <input type="text" class="form-control" id="DoiTuongThiDau" name="DoiTuongThiDau" value="<%= bangxephang.DoiTuongThiDau %>" required />
            </div>

            <div class="mb-3">
                <label for="SoTran" class="form-label">Số trận</label>
                <input type="number" class="form-control" id="SoTran" name="SoTran" value="<%= bangxephang.SoTran %>" />
            </div>

            <div class="mb-3">
                <label for="Thang" class="form-label">Thắng</label>
                <input type="number" class="form-control" id="Thang" name="Thang" value="<%= bangxephang.Thang %>" />
            </div>

            <div class="mb-3">
                <label for="Thua" class="form-label">Thua</label>
                <input type="number" class="form-control" id="Thua" name="Thua" value="<%= bangxephang.Thua %>" />
            </div>

            <div class="mb-3">
                <label for="HieuSo" class="form-label">Hiệu số</label>
                <input type="number" class="form-control" id="HieuSo" name="HieuSo" value="<%= bangxephang.HieuSo %>" />
            </div>

            <div class="mb-3">
                <label for="Diem" class="form-label">Điểm</label>
                <input type="number" class="form-control" id="Diem" name="Diem" value="<%= bangxephang.Diem %>" />
            </div>

            <div class="mb-3">
                <label for="XepHang" class="form-label">Xếp hạng</label>
                <input type="number" class="form-control" id="XepHang" name="XepHang" value="<%= bangxephang.XepHang %>" />
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a href="/bangxephang" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</body>
</html>