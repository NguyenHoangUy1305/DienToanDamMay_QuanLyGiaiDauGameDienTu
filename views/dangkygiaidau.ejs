<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <% 
        if (typeof canManage === 'undefined') { var canManage = false; }
        if (typeof isAdmin === 'undefined') { var isAdmin = false; }
        if (typeof message === 'undefined') { var message = ''; }
    %>
    <div class="container mt-4">
        <%- include('partials/sidebar', { active: 'dangkygiaidau' }) %>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Quản lý đăng ký giải đấu</h2>
            <% if (canManage) { %>
                <div>
                    <a href="/dangkygiaidau/them?mode=1vs1" class="btn btn-success me-2"><i class="bi bi-person-fill"></i> Thêm đăng ký 1vs1</a>
                    <a href="/dangkygiaidau/them?mode=doi" class="btn btn-primary"><i class="bi bi-people-fill"></i> Thêm đăng ký đội</a>
                </div>
            <% } %>
        </div>
        <div class="mb-3"><%- message %></div>
        <div class="card">
            <div class="card-body">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#dk1vs1" type="button">Đăng ký 1vs1 (<%= (dangKySolo || []).length %>)</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dkDoi" type="button">Đăng ký đồng đội (<%= (dangKyTeam || []).length %>)</button></li>
                </ul>

                <div class="tab-content border border-top-0 p-3 bg-white">
                    <div class="tab-pane fade show active" id="dk1vs1">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Giải đấu</th>
                                    <th>Người chơi</th>
                                    <th>Ngày đăng ký</th>
                                    <th>Trạng thái duyệt</th>
                                    <th width="170">Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if ((dangKySolo || []).length > 0) { %>
                                    <% (dangKySolo || []).forEach(function(item) { %>
                                        <tr>
                                            <td><%= item.GiaiDau ? item.GiaiDau.TenGiaiDau : '' %></td>
                                            <td><%= item.NguoiChoi ? item.NguoiChoi.HoVaTen : '' %></td>
                                            <td><%= new Date(item.NgayDangKy).toLocaleDateString('vi-VN') %></td>
                                            <td><%= toVietnameseApprovalStatus(item.TrangThaiDuyet) %></td>
                                            <td>
                                                <% if (canManage) { %>
                                                    <a href="/dangkygiaidau/sua/<%= item._id %>" class="btn btn-warning btn-sm">Sửa</a>
                                                    <% if (isAdmin) { %>
                                                        <a href="/dangkygiaidau/xoa/<%= item._id %>" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                                                    <% } %>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center">Chưa có đăng ký 1vs1.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="tab-pane fade" id="dkDoi">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Giải đấu</th>
                                    <th>Đội tuyển</th>
                                    <th>Ngày đăng ký</th>
                                    <th>Trạng thái duyệt</th>
                                    <th width="170">Chức năng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if ((dangKyTeam || []).length > 0) { %>
                                    <% (dangKyTeam || []).forEach(function(item) { %>
                                        <tr>
                                            <td><%= item.GiaiDau ? item.GiaiDau.TenGiaiDau : '' %></td>
                                            <td><%= item.DoiTuyen ? item.DoiTuyen.TenDoi : '' %></td>
                                            <td><%= new Date(item.NgayDangKy).toLocaleDateString('vi-VN') %></td>
                                            <td><%= toVietnameseApprovalStatus(item.TrangThaiDuyet) %></td>
                                            <td>
                                                <% if (canManage) { %>
                                                    <a href="/dangkygiaidau/sua/<%= item._id %>" class="btn btn-warning btn-sm">Sửa</a>
                                                    <% if (isAdmin) { %>
                                                        <a href="/dangkygiaidau/xoa/<%= item._id %>" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                                                    <% } %>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center">Chưa có đăng ký đồng đội.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>