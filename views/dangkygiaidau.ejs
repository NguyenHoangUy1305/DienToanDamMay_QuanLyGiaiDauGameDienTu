<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body class="bg-light">
    <% 
        if (typeof canManage === 'undefined') { var canManage = false; }
        if (typeof isAdmin === 'undefined') { var isAdmin = false; }
        
        function getBadge(status) {
            if(status === 'Da duyet' || status === 'Đã duyệt') return '<span class="badge bg-success px-2 py-1">Đã duyệt</span>';
            if(status === 'Tu choi' || status === 'Từ chối') return '<span class="badge bg-danger px-2 py-1">Từ chối</span>';
            return '<span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>';
        }
    %>
    <div class="container mt-4">
        <%- include('partials/sidebar', { active: 'dangkygiaidau' }) %>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i><%= title %></h2>
            <% if (canManage) { %>
                <div>
                    <a href="/dangkygiaidau/them?mode=1vs1" class="btn btn-success me-2 shadow-sm"><i class="bi bi-person-fill"></i> Thêm đăng ký 1vs1</a>
                    <a href="/dangkygiaidau/them?mode=doi" class="btn btn-primary shadow-sm"><i class="bi bi-people-fill"></i> Thêm đăng ký Đội</a>
                </div>
            <% } else { %>
                <a href="/giaidau" class="btn btn-primary shadow-sm"><i class="bi bi-search"></i> Tìm giải đấu mới</a>
            <% } %>
        </div>

        <% if (session && session.success) { %>
            <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i><%= session.success %><button class="btn-close" data-bs-dismiss="alert"></button></div>
            <% delete session.success; %>
        <% } %>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <ul class="nav nav-tabs px-3 pt-3" role="tablist">
                    <li class="nav-item"><button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#dk1vs1">Cá nhân 1vs1 (<%= (dangKySolo || []).length %>)</button></li>
                    <li class="nav-item"><button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#dkDoi">Đồng đội (<%= (dangKyTeam || []).length %>)</button></li>
                </ul>

                <div class="tab-content bg-white p-3">
                    <div class="tab-pane fade show active" id="dk1vs1">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr><th>Giải đấu</th><th>Người chơi</th><th>Ngày nộp</th><th class="text-center">Trạng thái</th><th class="text-end" width="180">Hành động</th></tr>
                            </thead>
                            <tbody>
                                <% if ((dangKySolo || []).length > 0) { %>
                                    <% dangKySolo.forEach(function(item) { %>
                                        <tr>
                                            <td class="fw-bold text-primary"><%= item.GiaiDau ? item.GiaiDau.TenGiaiDau : 'N/A' %></td>
                                            <td><%= item.NguoiChoi ? item.NguoiChoi.HoVaTen : 'N/A' %></td>
                                            <td><%= new Date(item.NgayDangKy).toLocaleDateString('vi-VN') %></td>
                                            <td class="text-center"><%- getBadge(item.TrangThaiDuyet) %></td>
                                            <td class="text-end">
                                                <% if (canManage) { %>
                                                    <% if (item.TrangThaiDuyet === 'Cho duyet') { %>
                                                        <form action="/dangkygiaidau/duyet-nhanh/<%= item._id %>" method="POST" style="display:inline;">
                                                            <input type="hidden" name="TrangThaiDuyet" value="Da duyet">
                                                            <button class="btn btn-sm btn-success" title="Duyệt"><i class="bi bi-check-lg"></i></button>
                                                        </form>
                                                        <form action="/dangkygiaidau/duyet-nhanh/<%= item._id %>" method="POST" style="display:inline;">
                                                            <input type="hidden" name="TrangThaiDuyet" value="Tu choi">
                                                            <button class="btn btn-sm btn-danger" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                                        </form>
                                                    <% } %>
                                                    <a href="/dangkygiaidau/sua/<%= item._id %>" class="btn btn-warning btn-sm" title="Sửa"><i class="bi bi-pencil"></i></a>
                                                    <% if (isAdmin) { %>
                                                        <form action="/dangkygiaidau/xoa/<%= item._id %>" method="post" style="display:inline" onsubmit="return confirm('Xóa đơn này?');">
                                                            <button class="btn btn-danger btn-sm" title="Xóa"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    <% } %>
                                                <% } else { %>
                                                    <% if (item.TrangThaiDuyet === 'Cho duyet') { %>
                                                        <form action="/dangkygiaidau/xoa/<%= item._id %>" method="post" style="display:inline" onsubmit="return confirm('Bạn muốn rút đơn này?');">
                                                            <button class="btn btn-outline-danger btn-sm">Rút đơn</button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="text-muted small">Không thể sửa</span>
                                                    <% } %>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-4">Chưa có đơn 1vs1 nào.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="tab-pane fade" id="dkDoi">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr><th>Giải đấu</th><th>Đội tuyển</th><th>Ngày nộp</th><th class="text-center">Trạng thái</th><th class="text-end" width="180">Hành động</th></tr>
                            </thead>
                            <tbody>
                                <% if ((dangKyTeam || []).length > 0) { %>
                                    <% dangKyTeam.forEach(function(item) { %>
                                        <tr>
                                            <td class="fw-bold text-primary"><%= item.GiaiDau ? item.GiaiDau.TenGiaiDau : 'N/A' %></td>
                                            <td><span class="fw-bold text-dark"><%= item.DoiTuyen ? item.DoiTuyen.TenDoi : 'N/A' %></span></td>
                                            <td><%= new Date(item.NgayDangKy).toLocaleDateString('vi-VN') %></td>
                                            <td class="text-center"><%- getBadge(item.TrangThaiDuyet) %></td>
                                            <td class="text-end">
                                                <% if (canManage) { %>
                                                    <% if (item.TrangThaiDuyet === 'Cho duyet') { %>
                                                        <form action="/dangkygiaidau/duyet-nhanh/<%= item._id %>" method="POST" style="display:inline;">
                                                            <input type="hidden" name="TrangThaiDuyet" value="Da duyet">
                                                            <button class="btn btn-sm btn-success" title="Duyệt"><i class="bi bi-check-lg"></i></button>
                                                        </form>
                                                        <form action="/dangkygiaidau/duyet-nhanh/<%= item._id %>" method="POST" style="display:inline;">
                                                            <input type="hidden" name="TrangThaiDuyet" value="Tu choi">
                                                            <button class="btn btn-sm btn-danger" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                                        </form>
                                                    <% } %>
                                                    <a href="/dangkygiaidau/sua/<%= item._id %>" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                                                    <% if (isAdmin) { %>
                                                        <form action="/dangkygiaidau/xoa/<%= item._id %>" method="post" style="display:inline" onsubmit="return confirm('Xóa đơn này?');">
                                                            <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    <% } %>
                                                <% } else { %>
                                                    <% if (item.TrangThaiDuyet === 'Cho duyet') { %>
                                                        <form action="/dangkygiaidau/xoa/<%= item._id %>" method="post" style="display:inline" onsubmit="return confirm('Bạn muốn rút đơn này?');">
                                                            <button class="btn btn-outline-danger btn-sm">Rút đơn</button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="text-muted small">Không thể sửa</span>
                                                    <% } %>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-4">Chưa có đơn giải đội nào.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>