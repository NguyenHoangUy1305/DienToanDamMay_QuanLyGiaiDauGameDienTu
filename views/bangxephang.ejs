<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <div class="container mt-4">
        <%- include('partials/sidebar', { active: 'bangxephang' }) %>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-3">Bảng xếp hạng</h2>
            <div>
                <form id="filterForm" method="get" action="/bangxephang" class="d-flex align-items-center">
                    <label class="me-2">Giải:</label>
                    <select name="GiaiDau" id="GiaiDauSelect" class="form-select form-select-sm me-2">
                        <option value="">-- Tất cả --</option>
                        <% if (giaidau && giaidau.length) { %>
                            <% giaidau.forEach(function(g) { %>
                                <option value="<%= g._id %>" <%= selectedGiaiDau && selectedGiaiDau.toString() === (g._id.toString()) ? 'selected' : '' %>><%= g.TenGiaiDau %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" type="submit">Lọc</button>
                </form>
            </div>
        </div>
        <% var msg = (typeof message !== 'undefined') ? message : (typeof locals !== 'undefined' && locals.message) ? locals.message : ''; %>
        <% if (msg) { %>
            <div class="mb-3"><%- msg %></div>
        <% } %>

        <ul class="nav nav-tabs" id="bxhTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="canhan-tab" data-bs-toggle="tab" data-bs-target="#canhan" type="button" role="tab">BXH cá nhân</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="doi-tab" data-bs-toggle="tab" data-bs-target="#doi" type="button" role="tab">BXH giải đội</button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 p-3 bg-white" id="bxhTabContent">
            <div class="tab-pane fade show active" id="canhan" role="tabpanel">
                <%- include('partials/bangxephang_table', { data: bangxephangCaNhan, emptyText: 'Chưa có dữ liệu BXH cá nhân.' }) %>
            </div>
            <div class="tab-pane fade" id="doi" role="tabpanel">
                <%- include('partials/bangxephang_table', { data: bangxephangDoi, emptyText: 'Chưa có dữ liệu BXH giải đội.' }) %>
            </div>
        </div>
    </div>

    <script>
        // auto-submit when changing tournament selection
        document.getElementById('GiaiDauSelect') && document.getElementById('GiaiDauSelect').addEventListener('change', function () {
            document.getElementById('filterForm').submit();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
