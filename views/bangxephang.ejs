<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
    <style>
        .rank-1 { background-color: rgba(255, 215, 0, 0.15) !important; font-weight: bold; }
        .table-vcenter td, .table-vcenter th { vertical-align: middle; }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'bangxephang' }) %>
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold"><i class="bi bi-trophy-fill text-warning me-2"></i>Bảng xếp hạng</h2>
            <form id="filterForm" method="get" action="/bangxephang" class="d-flex gap-2">
                <select name="GiaiDau" id="GiaiDauSelect" class="form-select shadow-sm" onchange="this.form.submit()">
                    <option value="">-- Chọn giải đấu --</option>
                    <% (giaidau || []).forEach(function(g) { %>
                        <option value="<%= g._id %>" <%= selectedGiaiDau == g._id.toString() ? 'selected' : '' %>><%= g.TenGiaiDau %></option>
                    <% }) %>
                </select>
            </form>
        </div>

        <ul class="nav nav-pills mb-3" id="bxhTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#canhan" type="button">Giải cá nhân</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#doi" type="button">Giải đồng đội</button>
            </li>
        </ul>

        <div class="tab-content card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="tab-pane fade show active" id="canhan">
                <div class="table-responsive">
                    <table class="table table-hover table-vcenter mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center">Hạng</th>
                                <th>Người chơi</th>
                                <th class="text-center">Trận</th>
                                <th class="text-center">T/H/B</th>
                                <th class="text-center">Bàn thắng/bại</th>
                                <th class="text-center">Hiệu số</th>
                                <th class="text-center">Điểm</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bangxephangCaNhan.length > 0) { %>
                                <% bangxephangCaNhan.forEach(function(item) { %>
                                    <tr class="<%= item.XepHang === 1 ? 'rank-1' : '' %>">
                                        <td class="text-center"><span class="badge <%= item.XepHang <=3 ? 'bg-primary' : 'bg-secondary' %>"><%= item.XepHang %></span></td>
                                        <td><strong><%= item.TenHienThi || item.DoiTuongThiDau %></strong></td>
                                        <td class="text-center"><%= item.SoTran %></td>
                                        <td class="text-center"><%= item.Thang %>/<%= item.Hoa %>/<%= item.Thua %></td>
                                        <td class="text-center"><%= item.BanThang %>-<%= item.BanThua %></td>
                                        <td class="text-center"><%= item.HieuSo > 0 ? '+' + item.HieuSo : item.HieuSo %></td>
                                        <td class="text-center text-primary fw-bold"><%= item.Diem %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu cho giải đấu này.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="doi">
                <div class="table-responsive">
                    <table class="table table-hover table-vcenter mb-0">
                        <thead class="table-info">
                            <tr>
                                <th class="text-center">Hạng</th>
                                <th>Đội tuyển</th>
                                <th class="text-center">Trận</th>
                                <th class="text-center">T/H/B</th>
                                <th class="text-center">Bàn thắng/bại</th>
                                <th class="text-center">Hiệu số</th>
                                <th class="text-center">Điểm</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bangxephangDoi.length > 0) { %>
                                <% bangxephangDoi.forEach(function(item) { %>
                                    <tr class="<%= item.XepHang === 1 ? 'rank-1' : '' %>">
                                        <td class="text-center"><strong><%= item.XepHang %></strong></td>
                                        <td><strong><%= item.TenHienThi || item.DoiTuongThiDau %></strong></td>
                                        <td class="text-center"><%= item.SoTran %></td>
                                        <td class="text-center"><%= item.Thang %>/<%= item.Hoa %>/<%= item.Thua %></td>
                                        <td class="text-center"><%= item.BanThang %>-<%= item.BanThua %></td>
                                        <td class="text-center"><%= item.HieuSo > 0 ? '+' + item.HieuSo : item.HieuSo %></td>
                                        <td class="text-center text-danger fw-bold"><%= item.Diem %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu BXH đội.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
