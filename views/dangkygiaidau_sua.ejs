<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'dangkygiaidau' }) %>
    <div class="container mt-4">
        <h2 class="mb-4">Sửa đăng ký giải đấu</h2>

        <form action="/dangkygiaidau/sua/<%= dangkygiaidau._id %>" method="post">
            <div class="mb-3">
                <label for="GiaiDau" class="form-label">Giải đấu</label>
                <select class="form-select" id="GiaiDau" name="GiaiDau" required>
                    <% giaidau.forEach(function(item) { %>
                        <option value="<%= item._id %>" <%= dangkygiaidau.GiaiDau && dangkygiaidau.GiaiDau.toString() === item._id.toString() ? 'selected' : '' %>>
                            <%= item.TenGiaiDau %> (<%= item.TheThuc %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="NguoiChoi" class="form-label">Người chơi (chỉ dùng cho giải 1vs1)</label>
                <select class="form-select" id="NguoiChoi" name="NguoiChoi">
                    <option value="">-- Không chọn --</option>
                    <% nguoichoi.forEach(function(item) { %>
                        <option value="<%= item._id %>" <%= dangkygiaidau.NguoiChoi && dangkygiaidau.NguoiChoi.toString() === item._id.toString() ? 'selected' : '' %>>
                            <%= item.HoVaTen %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="DoiTuyen" class="form-label">Đội tuyển (chỉ dùng cho giải đội)</label>
                <select class="form-select" id="DoiTuyen" name="DoiTuyen">
                    <option value="">-- Không chọn --</option>
                    <% doituyen.forEach(function(item) { %>
                        <option value="<%= item._id %>" <%= dangkygiaidau.DoiTuyen && dangkygiaidau.DoiTuyen.toString() === item._id.toString() ? 'selected' : '' %>>
                            <%= item.TenDoi %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label for="NgayDangKy" class="form-label">Ngày đăng ký</label>
                <input type="date" class="form-control" id="NgayDangKy" name="NgayDangKy"
                       value="<%= new Date(dangkygiaidau.NgayDangKy).toISOString().split('T')[0] %>" required />
            </div>

            <div class="mb-3">
                <label for="TrangThaiDuyet" class="form-label">Trạng thái duyệt</label>
                <select class="form-select" id="TrangThaiDuyet" name="TrangThaiDuyet">
                    <option value="Cho duyet" <%= ['Cho duyet','Chờ duyệt'].includes(dangkygiaidau.TrangThaiDuyet) ? 'selected' : '' %>>Chờ duyệt</option>
                    <option value="Da duyet" <%= ['Da duyet','Đã duyệt'].includes(dangkygiaidau.TrangThaiDuyet) ? 'selected' : '' %>>Đã duyệt</option>
                    <option value="Tu choi" <%= ['Tu choi','Từ chối'].includes(dangkygiaidau.TrangThaiDuyet) ? 'selected' : '' %>>Từ chối</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a href="/dangkygiaidau" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>

    <script id="giaiDauMetaData" type="application/json"><%- JSON.stringify(giaiDauMeta || []) %></script>
    <script>
        const giaiDauMeta = JSON.parse(
            document.getElementById('giaiDauMetaData').textContent || '[]'
        );
        const giaiDauSelect = document.getElementById('GiaiDau');
        const nguoiChoiSelect = document.getElementById('NguoiChoi');
        const doiTuyenSelect = document.getElementById('DoiTuyen');

        function applyMode() {
            const selected = giaiDauMeta.find(x => x.id === giaiDauSelect.value);
            const isTeam = selected ? selected.isTeam : false;

            nguoiChoiSelect.disabled = !!isTeam;
            doiTuyenSelect.disabled = !isTeam;

            if (isTeam) {
                nguoiChoiSelect.value = '';
            } else {
                doiTuyenSelect.value = '';
            }
        }

        giaiDauSelect.addEventListener('change', applyMode);
        applyMode();
    </script>
</body>
</html>
