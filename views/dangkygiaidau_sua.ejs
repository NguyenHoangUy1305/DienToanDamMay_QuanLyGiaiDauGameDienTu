<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'dangkygiaidau' }) %>
    <div class="container mt-4">
        <h2 class="mb-4 fw-bold">Chỉnh sửa đơn đăng ký</h2>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form action="/dangkygiaidau/sua/<%= dangkygiaidau._id %>" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Giải đấu</label>
                        <select class="form-select bg-light" id="GiaiDau" name="GiaiDau" required>
                            <% (giaidau || []).forEach(function(item) { %>
                                <option value="<%= item._id %>" <%= dangkygiaidau.GiaiDau && dangkygiaidau.GiaiDau.toString() === item._id.toString() ? 'selected' : '' %>>
                                    <%= item.TenGiaiDau %> (<%= item.TheThuc %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Người chơi (giải 1vs1)</label>
                            <select class="form-select" id="NguoiChoi" name="NguoiChoi">
                                <option value="">-- Không chọn --</option>
                                <% (nguoichoi || []).forEach(function(item) { %>
                                    <option value="<%= item._id %>" <%= dangkygiaidau.NguoiChoi && dangkygiaidau.NguoiChoi.toString() === item._id.toString() ? 'selected' : '' %>>
                                        <%= item.HoVaTen %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Đội tuyển (giải đội)</label>
                            <select class="form-select" id="DoiTuyen" name="DoiTuyen">
                                <option value="">-- Không chọn --</option>
                                <% (doituyen || []).forEach(function(item) { %>
                                    <option value="<%= item._id %>" <%= dangkygiaidau.DoiTuyen && dangkygiaidau.DoiTuyen.toString() === item._id.toString() ? 'selected' : '' %>>
                                        <%= item.TenDoi %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ngày đăng ký</label>
                            <input type="date" class="form-control" name="NgayDangKy" value="<%= new Date(dangkygiaidau.NgayDangKy).toISOString().split('T')[0] %>" required />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-bold text-primary">Trạng thái duyệt</label>
                            <select class="form-select border-primary" name="TrangThaiDuyet">
                                <option value="Cho duyet" <%= ['Cho duyet','Chờ duyệt'].includes(dangkygiaidau.TrangThaiDuyet) ? 'selected' : '' %>>Chờ duyệt</option>
                                <option value="Da duyet" <%= ['Da duyet','Đã duyệt'].includes(dangkygiaidau.TrangThaiDuyet) ? 'selected' : '' %>>Đã duyệt</option>
                                <option value="Tu choi" <%= ['Tu choi','Từ chối'].includes(dangkygiaidau.TrangThaiDuyet) ? 'selected' : '' %>>Từ chối</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning px-4 fw-bold">Cập nhật đơn</button>
                    <a href="/dangkygiaidau" class="btn btn-secondary px-4">Quay lại</a>
                </form>
            </div>
        </div>

        <script id="giaiDauMetaData" type="application/json"><%- JSON.stringify(typeof giaiDauMeta !== 'undefined' ? giaiDauMeta : []) %></script>
        <script>
            const meta = JSON.parse(document.getElementById('giaiDauMetaData').textContent);
            const gdSel = document.getElementById('GiaiDau');
            const ncSel = document.getElementById('NguoiChoi');
            const dtSel = document.getElementById('DoiTuyen');

            function applyMode() {
                if (!gdSel.value) return;
                const selected = meta.find(x => x.id === gdSel.value);
                const isTeam = selected ? selected.isTeam : false;

                ncSel.disabled = isTeam;
                dtSel.disabled = !isTeam;

                if (isTeam) { ncSel.value = ''; } else { dtSel.value = ''; }
            }

            gdSel.addEventListener('change', applyMode);
            applyMode();
        </script>
    </div>
</body>
</html>