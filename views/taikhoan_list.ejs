<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - FC Online</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'taikhoan' }) %>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Quản lý tài khoản</h2>
            <span class="badge bg-danger p-2"><i class="bi bi-shield-lock-fill"></i> Chỉ Admin</span>
        </div>

        <% if (session.error) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= session.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% delete session.error; // Xóa lỗi sau khi hiển thị để không hiện lại khi reload %>
        <% } %>

        <% if (session.success) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-3">
                <i class="bi bi-check-circle-fill me-2"></i> <%= session.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% delete session.success; // Xóa thông báo sau khi hiển thị %>
        <% } %>

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body">
                <h5 class="mb-3">Tạo tài khoản nội bộ (Admin / Nhân viên)</h5>
                <form action="/taikhoan/them-noibo" method="post" class="row g-2">
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="HoVaTen" placeholder="Họ và tên" required />
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="TenDangNhap" placeholder="Tên đăng nhập" required />
                    </div>
                    <div class="col-md-3">
                        <input type="password" class="form-control" name="MatKhau" placeholder="Mật khẩu" required />
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="QuyenHan" required>
                            <option value="nhanvien">Nhân viên</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-grid">
                        <button class="btn btn-success" type="submit">Thêm</button>
                    </div>
                    <div class="col-md-12">
                        <input type="email" class="form-control" name="Email" placeholder="Email (không bắt buộc)" />
                    </div>
                </form>
            </div>
        </div>

        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-admin" type="button">Admin (<%= (admins || []).length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-nhanvien" type="button">Nhân viên (<%= (nhanviens || []).length %>)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-nguoichoi" type="button">Người chơi (<%= (nguoichois || []).length %>)</button></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-admin">
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark"><tr><th>Họ tên</th><th>User</th><th>Email</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                            <tbody>
                                <% if ((admins || []).length) { %>
                                    <% admins.forEach(function(t) { %>
                                        <tr>
                                            <td><%= t.HoVaTen %></td>
                                            <td><%= t.TenDangNhap %></td>
                                            <td><%= t.Email || '' %></td>
                                            <td><span class="badge <%= t.KichHoat ? 'bg-success' : 'bg-warning text-dark' %>"><%= t.KichHoat ? 'Kích hoạt' : 'Đang khóa' %></span></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-warning" data-bs-toggle="collapse" data-bs-target="#edit-<%= t._id %>">Sửa</button>
                                                
                                                <% if (currentUserId !== t._id.toString()) { %>
                                                    <form action="/taikhoan/xoa-noibo/<%= t._id %>" method="post" style="display:inline" onsubmit="return confirm('Xóa tài khoản admin này?');">
                                                        <button class="btn btn-sm btn-danger">Xóa</button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Tài khoản hiện tại</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <tr class="collapse" id="edit-<%= t._id %>">
                                            <td colspan="5" class="bg-light">
                                                <form action="/taikhoan/sua-noibo/<%= t._id %>" method="post" class="row g-2">
                                                    <div class="col-md-3"><input type="text" class="form-control" name="HoVaTen" value="<%= t.HoVaTen %>" required /></div>
                                                    <div class="col-md-3"><input type="email" class="form-control" name="Email" value="<%= t.Email || '' %>" /></div>
                                                    <div class="col-md-3"><input type="password" class="form-control" name="MatKhauMoi" placeholder="Mật khẩu mới (để trống nếu giữ nguyên)" /></div>
                                                    <div class="col-md-2">
                                                        <select name="KichHoat" class="form-select">
                                                            <option value="1" <%= t.KichHoat ? 'selected' : '' %>>Kích hoạt</option>
                                                            <option value="0" <%= !t.KichHoat ? 'selected' : '' %>>Khóa</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-1 d-grid"><button class="btn btn-primary">Lưu</button></div>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có tài khoản admin.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-nhanvien">
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark"><tr><th>Họ tên</th><th>User</th><th>Email</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                            <tbody>
                                <% if ((nhanviens || []).length) { %>
                                    <% nhanviens.forEach(function(t) { %>
                                        <tr>
                                            <td><%= t.HoVaTen %></td>
                                            <td><%= t.TenDangNhap %></td>
                                            <td><%= t.Email || '' %></td>
                                            <td><span class="badge <%= t.KichHoat ? 'bg-success' : 'bg-warning text-dark' %>"><%= t.KichHoat ? 'Kích hoạt' : 'Đang khóa' %></span></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-warning" data-bs-toggle="collapse" data-bs-target="#edit-<%= t._id %>">Sửa</button>
                                                <form action="/taikhoan/xoa-noibo/<%= t._id %>" method="post" style="display:inline" onsubmit="return confirm('Xóa tài khoản nhân viên này?');">
                                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <tr class="collapse" id="edit-<%= t._id %>">
                                            <td colspan="5" class="bg-light">
                                                <form action="/taikhoan/sua-noibo/<%= t._id %>" method="post" class="row g-2">
                                                    <div class="col-md-3"><input type="text" class="form-control" name="HoVaTen" value="<%= t.HoVaTen %>" required /></div>
                                                    <div class="col-md-3"><input type="email" class="form-control" name="Email" value="<%= t.Email || '' %>" /></div>
                                                    <div class="col-md-3"><input type="password" class="form-control" name="MatKhauMoi" placeholder="Mật khẩu mới (để trống nếu giữ nguyên)" /></div>
                                                    <div class="col-md-2">
                                                        <select name="KichHoat" class="form-select">
                                                            <option value="1" <%= t.KichHoat ? 'selected' : '' %>>Kích hoạt</option>
                                                            <option value="0" <%= !t.KichHoat ? 'selected' : '' %>>Khóa</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-1 d-grid"><button class="btn btn-primary">Lưu</button></div>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có tài khoản nhân viên.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-nguoichoi">
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark"><tr><th>Họ tên</th><th>User</th><th>Email</th><th class="text-center">Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                            <tbody>
                                <% if ((nguoichois || []).length) { %>
                                    <% nguoichois.forEach(function(t) { %>
                                        <tr>
                                            <td><%= t.HoVaTen %></td>
                                            <td><%= t.TenDangNhap %></td>
                                            <td><%= t.Email || '' %></td>
                                            <td class="text-center">
                                                <% if (t.KichHoat) { %>
                                                    <span class="badge bg-success">Đã kích hoạt</span>
                                                <% } else { %>
                                                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <% if (!t.KichHoat) { %>
                                                    <form action="/taikhoan/duyet/<%= t._id %>" method="post" style="display:inline">
                                                        <button class="btn btn-sm btn-success">Duyệt</button>
                                                    </form>
                                                <% } else { %>
                                                    <span class="text-muted small">Giữ nguyên theo nghiệp vụ người chơi</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có tài khoản người chơi.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>