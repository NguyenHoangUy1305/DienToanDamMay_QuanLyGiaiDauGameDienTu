<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title><%= title %> - FC Online</title>
</head>
<body>
    <%- include('partials/sidebar', { active: 'trandau' }) %>
    <div class="container mt-4">
        <h2 class="mb-4">Chỉnh sửa trận đấu</h2>

        <form action="/trandau/sua/<%= trandau._id %>" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Giải đấu</label>
                <select class="form-select bg-light" name="GiaiDau" id="GiaiDau" required>
                    <% (giaidau || []).forEach(function(item) { %>
                        <option value="<%= item._id %>" <%= trandau.GiaiDau && trandau.GiaiDau.toString() === item._id.toString() ? 'selected' : '' %>>
                            <%= item.TenGiaiDau %> (<%= item.TheThuc %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Kiểu đối tượng</label>
                <select class="form-select bg-light" id="LoaiDoiTuongThiDau" name="LoaiDoiTuongThiDau">
                    <option value="NguoiChoi" <%= trandau.LoaiDoiTuongThiDau === 'NguoiChoi' ? 'selected' : '' %>>Cá nhân</option>
                    <option value="DoiTuyen" <%= trandau.LoaiDoiTuongThiDau === 'DoiTuyen' ? 'selected' : '' %>>Đội tuyển</option>
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-primary">Đối thủ 1</label>
                    <select class="form-select border-primary" id="DoiThu1Id" name="DoiThu1Id" required></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-danger">Đối thủ 2</label>
                    <select class="form-select border-danger" id="DoiThu2Id" name="DoiThu2Id" required></select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Thời gian thi đấu</label>
                <% 
                    var d = new Date(trandau.ThoiGianThiDau);
                    var dateStr = new Date(d.getTime() - (d.getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
                %>
                <input type="datetime-local" class="form-control" name="ThoiGianThiDau" value="<%= dateStr %>" required />
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Tỷ số đối thủ 1</label>
                    <input type="number" class="form-control" name="TySo1" value="<%= trandau.TySo1 %>" min="0" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Tỷ số đối thủ 2</label>
                    <input type="number" class="form-control" name="TySo2" value="<%= trandau.TySo2 %>" min="0" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Trạng thái</label>
                <select class="form-select" name="TrangThai">
                    <option value="Chua thi dau" <%= (trandau.TrangThai === 'Chua thi dau' || trandau.TrangThai === 'SCHEDULED' || trandau.TrangThai === 'Chưa thi đấu') ? 'selected' : '' %>>Chưa thi đấu</option>
                    <option value="Da thi dau" <%= (trandau.TrangThai === 'Da thi dau' || trandau.TrangThai === 'FINISHED' || trandau.TrangThai === 'Đã thi đấu') ? 'selected' : '' %>>Đã thi đấu</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật trận đấu</button>
            <a href="/trandau" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>

    <script id="edit-data" type="application/json">
        <%- JSON.stringify({
            giaiDauMeta: giaiDauMeta || [],
            sDoi1: trandau.DoiThu1Id ? trandau.DoiThu1Id.toString() : '',
            sDoi2: trandau.DoiThu2Id ? trandau.DoiThu2Id.toString() : '',
            sLoai: trandau.LoaiDoiTuongThiDau || ''
        }) %>
    </script>

    <script>
        const editData = JSON.parse(document.getElementById('edit-data').textContent);
        const { giaiDauMeta, sDoi1, sDoi2, sLoai } = editData;

        const gdSelect = document.getElementById('GiaiDau');
        const d1Select = document.getElementById('DoiThu1Id');
        const d2Select = document.getElementById('DoiThu2Id');
        const lSelect = document.getElementById('LoaiDoiTuongThiDau');

        function applyData() {
            const meta = giaiDauMeta.find(g => g.id === gdSelect.value);
            if(!meta) return;

            const currentLoai = lSelect.value;
            const participants = meta.participants.filter(p => p.type === currentLoai);

            const options = ['<option value="">-- Chọn --</option>']
                .concat(participants.map(p => `<option value="${p.id}" ${p.id === sDoi1 || p.id === sDoi2 ? 'selected' : ''}>${p.name}</option>`))
                .join('');
            
            // Render d1 và d2 với giá trị đã chọn
            d1Select.innerHTML = ['<option value="">-- Chọn --</option>'].concat(participants.map(p => `<option value="${p.id}" ${p.id === sDoi1 ? 'selected' : ''}>${p.name}</option>`)).join('');
            d2Select.innerHTML = ['<option value="">-- Chọn --</option>'].concat(participants.map(p => `<option value="${p.id}" ${p.id === sDoi2 ? 'selected' : ''}>${p.name}</option>`)).join('');
        }

        gdSelect.addEventListener('change', applyData);
        lSelect.addEventListener('change', applyData);
        applyData();
    </script>
</body>
</html>
