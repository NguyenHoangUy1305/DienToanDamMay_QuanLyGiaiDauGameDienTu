<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <style>
        /* Thiết kế khung thông báo: mặc định có đường kẻ trái màu xám */
        .notify-card { border-left: 5px solid #dee2e6; transition: 0.3s; border-radius: 10px; }
        
        /* Nếu thông báo chưa đọc: đổi đường kẻ sang màu xanh và nền xanh nhạt */
        .notify-card.unread { border-left-color: #0d6efd; background-color: #f8fbff; }
        
        /* Nếu mức độ là quan trọng: đổi đường kẻ sang màu đỏ (Cấp bách) */
        .notify-card.urgent { border-left-color: #dc3545; }
        
        /* Hiệu ứng đổ bóng khi rê chuột qua card */
        .notify-card:hover { box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'thongbao' }) %>
    
    <div class="container py-4" style="max-width: 800px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0"><i class="bi bi-bell-fill text-warning me-2"></i>Thông báo</h2>
            <span class="badge bg-primary rounded-pill"><%= thongbao.length %> tin mới</span>
        </div>

        <% // Kiểm tra nếu có dữ liệu thông báo trong mảng %>
        <% if (thongbao && thongbao.length) { %>
            <% thongbao.forEach(function(item) { 
                // LOGIC: Kiểm tra xem ID của User hiện tại có nằm trong danh sách 'DaDoc' của thông báo này không
                var isRead = item.DaDoc && item.DaDoc.map(id => id.toString()).includes(currentUserId);
                
                // Gán class 'urgent' nếu mức độ thông báo chứa từ khóa 'quan trong'
                var mucDoClass = (item.MucDo || '').toLowerCase().includes('quan trong') ? 'urgent' : '';
            %>
                <div class="card notify-card mb-3 shadow-sm <%= isRead ? '' : 'unread' %> <%= mucDoClass %>">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title fw-bold text-dark mb-1">
                                <% // Hiện chấm xanh nhỏ nếu chưa đọc %>
                                <% if (!isRead) { %><i class="bi bi-circle-fill text-primary small me-2"></i><% } %>
                                <%= item.TieuDe %>
                            </h5>
                            <small class="text-muted"><%= new Date(item.createdAt).toLocaleDateString('vi-VN') %></small>
                        </div>
                        
                        <div class="mb-2">
                            <span class="badge bg-light text-primary border"><%= item.LoaiThongBao %></span>
                            <span class="small text-muted ms-2">Người gửi: <strong><%= item.NguoiGui ? item.NguoiGui.HoVaTen : 'Hệ thống' %></strong></span>
                        </div>

                        <p class="card-text text-secondary"><%= item.NoiDung %></p>
                        
                        <% // Nếu chưa đọc, hiện nút bấm để gọi hàm AJAX đánh dấu đã đọc %>
                        <% if (!isRead) { %>
                            <button onclick="markAsRead('<%= item._id %>')" class="btn btn-sm btn-link p-0 text-decoration-none">Đánh dấu đã đọc</button>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-mailbox fs-1 text-muted"></i>
                <p class="mt-2 text-muted">Hòm thư trống không, chưa có thông báo nào.</p>
            </div>
        <% } %>
    </div>

    <script>
        /**
         * Hàm gửi yêu cầu POST về server để đánh dấu thông báo là đã đọc
         * Sau khi thành công sẽ load lại trang để cập nhật giao diện
         */
        async function markAsRead(id) {
            const res = await fetch('/thongbao/doc/' + id, { method: 'POST' });
            if (res.ok) window.location.reload();
        }
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>