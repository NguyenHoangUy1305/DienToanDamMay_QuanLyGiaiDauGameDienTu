<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title>Khai báo kết quả - FC Online</title>
    <style>
        .score-card { border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .vs-circle {
            width: 50px; height: 50px;
            background: #f8f9fa;
            border: 2px solid #dee2e6;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: bold; margin: 0 auto;
            z-index: 10; position: relative;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('partials/sidebar', { active: 'trandau' }) %>

    <div class="container mt-4" style="max-width: 1000px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Khai báo kết quả thi đấu</h2>
            <span class="badge bg-primary fs-6"><%= trandau.GiaiDau ? trandau.GiaiDau.TenGiaiDau : 'Giải đấu' %></span>
        </div>

        <div class="mb-3"><%- message %></div>

        <div class="alert alert-info">
            <strong>Lưu ý:</strong> Vui lòng điền đầy đủ bàn thắng và dán Link Minh Chứng (Link ảnh chụp tỷ số up lên Imgur, Drive, Facebook hoặc Link clip Youtube). Kết quả sẽ được chuyển tới Ban Tổ Chức để duyệt trước khi lên Bảng Xếp Hạng. 
        </div>

        <form method="post" action="/trandau/khai-bao/<%= trandau._id %>">
            <div class="row align-items-center mb-4">
                <div class="col-md-5">
                    <div class="card score-card text-center p-3 border-primary border-3">
                        <h4 class="text-primary text-truncate"><%= trandau.DoiThu1 %></h4>

                        <% if (!isTeamMatch) { %>
                            <input type="number" class="form-control form-control-lg text-center fw-bold" name="TySo1" value="<%= trandau.TySo1 %>" min="0" required>
                        <% } else { %>
                            <div class="text-start mt-3">
                                <label class="small text-muted mb-2">Bàn thắng từng cầu thủ:</label>
                                <% (doiHinhDoi1 || []).forEach(function(p) { %>
                                    <div class="input-group mb-2">
                                        <span class="input-group-text small" style="width: 120px;"><%= p.HoVaTen %></span>
                                        <input type="number" class="form-control" name="BanThangDoi1[<%= p._id %>]" value="<%= (banThangDoi1Map && banThangDoi1Map[p._id.toString()] != null) ? banThangDoi1Map[p._id.toString()] : 0 %>" min="0" required>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="col-md-2 text-center">
                    <div class="vs-circle">VS</div>
                </div>

                <div class="col-md-5">
                    <div class="card score-card text-center p-3 border-danger border-3">
                        <h4 class="text-danger text-truncate"><%= trandau.DoiThu2 %></h4>

                        <% if (!isTeamMatch) { %>
                            <input type="number" class="form-control form-control-lg text-center fw-bold" name="TySo2" value="<%= trandau.TySo2 %>" min="0" required>
                        <% } else { %>
                            <div class="text-start mt-3">
                                <label class="small text-muted mb-2">Bàn thắng từng cầu thủ:</label>
                                <% (doiHinhDoi2 || []).forEach(function(p) { %>
                                    <div class="input-group mb-2">
                                        <span class="input-group-text small" style="width: 120px;"><%= p.HoVaTen %></span>
                                        <input type="number" class="form-control" name="BanThangDoi2[<%= p._id %>]" value="<%= (banThangDoi2Map && banThangDoi2Map[p._id.toString()] != null) ? banThangDoi2Map[p._id.toString()] : 0 %>" min="0" required>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="card p-3 mb-4 shadow-sm border-warning">
                <div class="mb-3">
                    <label class="form-label fw-bold text-warning-emphasis">Gắn Link Minh Chứng (Ảnh / Video bắt buộc):</label>
                    <input type="url" class="form-control form-control-lg" name="LinkMinhChung" placeholder="Nhập link Imgur, Facebook, Google Drive, Youtube..." value="<%= trandau.LinkMinhChung || '' %>" required>
                    <div class="form-text">Ví dụ: https://imgur.com/your-screenshot hoặc link Facebook bài post up ảnh.</div>
                </div>
            </div>

            <div class="card p-3 mb-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Vòng đấu:</label>
                        <span class="text-muted"><%= trandau.VongDau %></span>
                    </div>
                    <div class="col-md-6 text-end">
                        <button type="submit" class="btn btn-warning btn-lg shadow fw-bold text-dark">
                            <i class="bi bi-send-fill me-2"></i> Gửi dữ liệu Báo cáo
                        </button>
                        <a href="/trandau" class="btn btn-outline-secondary btn-lg ms-2">Hủy bỏ</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</body>
</html>
